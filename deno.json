{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno run --allow-read=posts,content,src,static,build --allow-write=build --allow-net --allow-env=CI,FORCE_COLOR,TERM scripts/dev.ts",
    "build": "deno run --allow-read=posts,content,src,static --allow-write=build --allow-env=CI,FORCE_COLOR,TERM scripts/build.ts",
    "preview": "deno run --allow-read=build --allow-net scripts/preview.ts",
    "check": "deno fmt --check . && deno lint . && deno check scripts/*.ts src/*.ts tests/*.ts",
    "test": "deno task test:unit && deno task build && deno task test:e2e",
    "test:unit": "deno test tests --allow-read=posts,content --allow-env=CI,FORCE_COLOR,TERM",
    "test:e2e": "deno run -A @playwright/test test",
    "deploy": "deno run -A wrangler deploy"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  },
  "exclude": ["build/", "node_modules/"],
  "imports": {
    "@playwright/test": "npm:@playwright/test@^1.61.1",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "wrangler": "npm:wrangler@^4.113.0"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.asynciterable", "dom.iterable", "esnext"]
  }
}
