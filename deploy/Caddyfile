{
	admin localhost:2019

	# Cloudflare proxies wlls.dev, so the visitor's address arrives in
	# CF-Connecting-IP. Trust that header only from Cloudflare's published
	# ranges (https://www.cloudflare.com/ips/, checked 2026-10-02); anyone
	# reaching the origin directly is identified by their own address.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$WLLS_SITE_ADDRESS:http://localhost:3000} {
	# The app sets security headers on every response (src/httpx/headers.odin).
	header -Server

	# zstd only. Cloudflare proxies wlls.dev and asks this origin for
	# "gzip, br", never zstd; offering gzip here made Cloudflare pass gzip
	# through to visitors for SSE and assets. Without it, Cloudflare receives
	# identity and compresses for each visitor itself (zstd, then br). Clients
	# that reach Caddy directly and accept zstd (local dev) still get it.
	#
	# HEAD must keep the upstream's actual length. Even small SSE events need
	# compression to start on the first flush, regardless of request method.
	@not_head not method HEAD
	encode @not_head zstd {
		minimum_length 1
	}
	# The app rate-limits guestbook signing by this address
	# (src/app/route_guestbook.odin). Setting it here replaces any value a
	# client sent.
	reverse_proxy {$WLLS_UPSTREAM:127.0.0.1:8080} {
		header_up X-Client-IP {client_ip}
	}
}

{$WLLS_REDIRECT_ADDRESS:http://www.localhost:3000} {
	redir {$WLLS_CANONICAL_URL:http://localhost:3000}{uri} permanent
}
