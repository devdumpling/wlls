[Unit]
Description=wlls.dev web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wlls
Group=wlls
WorkingDirectory=/var/lib/wlls
ExecStart=/nix/var/nix/profiles/wlls/bin/wlls
Restart=on-failure
RestartSec=2s
# Above the app's 30 s graceful drain (src/app/conf.odin).
TimeoutStopSec=35s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
StateDirectory=wlls

[Install]
WantedBy=multi-user.target
