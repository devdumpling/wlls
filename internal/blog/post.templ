package blog

templ Article(post Post, latest bool) {
	<article>
		<header class="article-header">
			<p class="post-meta">
				if post.Topic != "" {
					<span>{ post.Topic }</span>
					<span aria-hidden="true">· </span>
				}
				<time datetime={ post.PublishedAt.Format("2006-01-02") }>{ post.DisplayDate() }</time>
			</p>
			<h1>{ post.Title }</h1>
			<p class="article-dek">{ post.Description }</p>
		</header>
		<div class="article-body">
			@templ.Raw(post.HTML)
		</div>
		<footer class="article-footer">
			<a href="/blog">All writing</a>
		</footer>
	</article>
}
