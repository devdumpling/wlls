package hello

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>wlls.dev</title>
			<style>
				:root { color-scheme: light dark; font-family: system-ui, sans-serif; }
				body { max-width: 42rem; margin: 4rem auto; padding: 0 1rem; }
				button { cursor: pointer; font: inherit; padding: .5rem .75rem; }
			</style>
			<script type="module" src="/static/datastar.js"></script>
		</head>
		<body>
			<main>
				<p>Oh hi! You caught me rebuilding things from scratch... and uh, in an awkward mostly broken state. Check back later!</p>
				@Greeting("Hello, Devon.")
				<button type="button" data-on:click="@post('/hello')">Say hello</button>
			</main>
		</body>
	</html>
}

templ Greeting(message string) {
	<p id="greeting" role="status">{ message }</p>
}
