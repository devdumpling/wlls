package views

import content "../content"

about_page :: templ(page: content.Page, metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		<article class="article">
			<header class="article-header">
				<h1>{ page.title }</h1>
				<p class="article-dek">{ page.description }</p>
			</header>
			<div class="article-body">{! string(page.html) }</div>
		</article>
	}
}
