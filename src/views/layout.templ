package views

// The document shell owns site-wide metadata and navigation. Feature templates
// compose their page-specific resource inside the main landmark. Every page
// keeps the terminal in a sheet that the breadcrumb row's trigger (or `/`)
// opens. theme-color
// tints mobile browser chrome to the paper; keep it in step with --paper in
// garden.css.
document :: templ(metadata: Metadata, assets: Asset_URLs) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#1b1815" media="(prefers-color-scheme: dark)"/>
			<title>{ metadata.title }</title>
			<meta name="description" content={ metadata.description }/>
			if metadata.canonical != "" {
				<link rel="canonical" href={ metadata.canonical }/>
				<meta property="og:url" content={ metadata.canonical }/>
			}
			<meta property="og:title" content={ metadata.title }/>
			<meta property="og:description" content={ metadata.description }/>
			if metadata.open_graph != "" {
				<meta property="og:type" content={ metadata.open_graph }/>
			}
			if metadata.noindex {
				<meta name="robots" content="noindex"/>
			}
			if metadata.structured_data != "" {
				{! json_ld_script(metadata.structured_data) }
			}
			<link rel="alternate" type="application/rss+xml" title="wlls.dev" href={ assets.feed }/>
			<link rel="icon" href={ assets.favicon } type="image/svg+xml"/>
			<link rel="stylesheet" href={ assets.stylesheet }/>
			<link rel="stylesheet" href={ assets.garden }/>
			<script type="module" src={ assets.datastar }></script>
			if metadata.page == .Post {
				<script type="module" src={ assets.footnotes }></script>
			}
			if card(metadata.embeds) > 0 {
				<link rel="stylesheet" href={ assets.embeds }/>
				for script, embed in assets.embed_scripts {
					if embed in metadata.embeds {
						<script type="module" src={ script }></script>
					}
				}
			}
			if metadata.page == .Guestbook {
				<script type="module" src={ assets.relative_time }></script>
				<script type="module" src={ assets.pixel_board }></script>
			}
			<script type="module" src={ assets.terminal }></script>
		</head>
		<body data-page={ page_name(metadata.page) }>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<div class="shell">
				<div class="column">
					<div class="column-head">
						@breadcrumb(metadata.path)
						@terminal_trigger()
					</div>
					<main id="main-content">
						{#slot}
					</main>
				</div>
				@rail(metadata, assets)
			</div>
			@terminal_sheet()
			@live_mount(live_place(metadata))
		</body>
	</html>
}

// breadcrumb renders the request path as linked segments: wlls.dev / blog / devex.
breadcrumb :: templ(path: string) {
	{{ crumbs := breadcrumbs(path) }}
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<ol>
			for crumb, index in crumbs {
				<li>
					if index == len(crumbs) - 1 {
						<a href={ crumb.href } aria-current="page">{ crumb.label }</a>
					} else {
						<a href={ crumb.href }>{ crumb.label }</a>
					}
				</li>
			}
		</ol>
	</nav>
}

// rail is the site's only navigation, set apart on the right like a menu.
rail :: templ(metadata: Metadata, assets: Asset_URLs) {
	<aside class="rail">
		<nav aria-label="Primary">
			<ol class="rail-links">
				<li>
					<a href="/blog" if metadata.page == .Blog || metadata.page == .Post { aria-current="page" }>
						<span class="rail-glyph" aria-hidden="true">¶</span>
						<span class="rail-label">blog</span>
					</a>
				</li>
				<li>
					<a href="/guestbook" if metadata.page == .Guestbook { aria-current="page" }>
						<span class="rail-glyph" aria-hidden="true">:)</span>
						<span class="rail-label">guestbook</span>
					</a>
				</li>
				<li>
					<a href="/about" if metadata.page == .About { aria-current="page" }>
						<span class="rail-glyph" aria-hidden="true">&#64;</span>
						<span class="rail-label">whoami</span>
					</a>
				</li>
				<li>
					<a href={ assets.feed }>
						<span class="rail-glyph" aria-hidden="true">))</span>
						<span class="rail-label">rss</span>
					</a>
				</li>
				<li>
					<a href="https://github.com/devdumpling">
						<span class="rail-glyph" aria-hidden="true">&lt;&gt;</span>
						<span class="rail-label">github</span>
					</a>
				</li>
			</ol>
		</nav>
	</aside>
}

not_found :: templ() {
	<section class="message-page">
		<h1>Nothing grows here</h1>
		<p>Sorry fam this page doesn't exist. Idk either.</p>
		<a href="/">Take me away</a>
	</section>
}

not_found_document :: templ(metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		@not_found()
	}
}
