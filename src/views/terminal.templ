package views

import content "../content"

// The terminal is server-driven: a command posts as a form, and the reply is
// SSE patches rendered from these same components. <wlls-terminal> (a Rocket
// component) adds only client behavior: focus, history, scroll-follow, and the
// fold toggle. It is deliberately unannounced: a prompt and a blinking cursor.
// In the sheet, the bar's end carries a hint instead of the fold toggle: the
// sheet itself opens and closes.
terminal :: templ(in_sheet: bool) {
	<wlls-terminal id="terminal" class="terminal">
		@terminal_output()
		<div class="terminal-bar">
			@terminal_prompt()
			if in_sheet {
				<span class="terminal-hint" aria-hidden="true">/ to toggle</span>
			} else {
				<button type="button" class="terminal-toggle" aria-controls="terminal-output" aria-expanded="true" aria-label="Fold terminal output">[-]</button>
			}
		</div>
	</wlls-terminal>
}

// terminal_sheet hosts the same terminal off the landing page, in a modal
// dialog pinned to the bottom of the screen. The dialog supplies focus
// trapping, Esc to close, and focus return to the trigger.
terminal_sheet :: templ() {
	<dialog id="terminal-sheet" class="terminal-sheet" aria-label="Terminal">
		@terminal(true)
	</dialog>
}

// terminal_trigger sits at the end of the breadcrumb row: a quiet prompt that
// opens the sheet. <wlls-terminal> wires it up, along with the `/` shortcut.
terminal_trigger :: templ() {
	<button type="button" class="terminal-trigger" aria-haspopup="dialog" aria-controls="terminal-sheet" aria-keyshortcuts="/" aria-label="Open terminal">
		<span class="terminal-ps1" aria-hidden="true">~ $</span>
	</button>
}

terminal_output :: templ() {
	<div id="terminal-output" class="terminal-output" role="log" aria-live="polite" aria-label="Terminal output"></div>
}

terminal_prompt :: templ() {
	<form id="terminal-prompt" class="terminal-prompt" data-on:submit__prevent="@post('/terminal', {contentType: 'form'})">
		<label for="terminal-input" class="terminal-ps1">~ $</label>
		<input id="terminal-input" name="command" value="" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="120" enterkeyhint="send"/>
	</form>
}

terminal_echo :: templ(command: string) {
	<p class="terminal-echo"><span class="terminal-ps1" aria-hidden="true">~ $</span> { command }</p>
}

terminal_line :: templ(text: string) {
	<p class="terminal-line">{ text }</p>
}

terminal_error :: templ(text: string) {
	<p class="terminal-line terminal-error">{ text }</p>
}

terminal_link :: templ(text: string, href: string) {
	<p class="terminal-line"><a href={ href }>{ text }</a></p>
}

// terminal_navigate moves the browser once Datastar patches it into the log.
// It runs as a Datastar expression rather than an inline <script>, which the
// Content-Security-Policy does not allow.
terminal_navigate :: templ(path: string) {
	<span hidden data-init={ navigate_expression(path) }></span>
}

terminal_help :: templ() {
	<dl class="terminal-list">
		<dt>ls</dt>
		<dd>list posts</dd>
		<dt>cd &lt;place&gt;</dt>
		<dd>go somewhere: blog, about, ~, or a post</dd>
		<dt>whoami</dt>
		<dd>about me</dd>
		<dt>play</dt>
		<dd>start the game</dd>
		<dt>clear</dt>
		<dd>clear the screen</dd>
		<dt>exit</dt>
		<dd>close the terminal</dd>
	</dl>
	<p class="terminal-line">press / on any page to open the terminal</p>
}

terminal_posts :: templ(posts: []content.Post) {
	<ul class="terminal-list terminal-posts">
		for post in posts {
			<li><a href={ post.url }>{ post.slug }</a></li>
		}
	</ul>
}
