package views

import content "../content"

post_link :: templ(post: content.Post) {
	<li>
		<article>
			<a href={ post.url }>
				<h2>{ post.title }</h2>
				<p>{ post.description }</p>
				<p class="post-meta"><time datetime={ post.date }>{ post.date }</time></p>
			</a>
		</article>
	</li>
}

post_index :: templ(posts: []content.Post, metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		<section>
			<header class="article-header">
				<p class="eyebrow">Writing</p>
				<h1>Ideas in progress.</h1>
				<p class="article-dek">Essays and notes on software, games, and making things.</p>
			</header>
			<ol class="post-list">
				for post in posts {
					@post_link(post)
				}
			</ol>
		</section>
	}
}

post_page :: templ(post: content.Post, metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		<article>
			<header class="article-header">
				<p class="post-meta">
					if post.topic != "" {
						<span>{ post.topic }</span>
						<span aria-hidden="true"> · </span>
					}
					<time datetime={ post.date }>{ post.date }</time>
				</p>
				<h1>{ post.title }</h1>
				<p class="article-dek">{ post.description }</p>
			</header>
			<div class="article-body">{! string(post.html) }</div>
			<footer class="article-footer">
				<a href="/blog">All writing</a>
			</footer>
		</article>
	}
}
