package views

import content "../content"

post_link :: templ(post: content.Post) {
	<li>
		<article class="post-entry">
			<h2><a href={ post.url }>{ post.title }</a></h2>
			<p class="post-dek">{ post.description }</p>
		</article>
	</li>
}

post_index :: templ(posts: []content.Post, metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		<header class="page-header">
			<h1>Posts</h1>
		</header>
		<section class="post-section" aria-label="All posts">
			<ol class="post-list">
				for post in posts {
					@post_link(post)
				}
			</ol>
		</section>
	}
}

post_page :: templ(post: content.Post, metadata: Metadata, assets: Asset_URLs) {
	@document(metadata, assets) {
		<article class="article">
			<header class="article-header">
				<h1>{ post.title }</h1>
				<p class="article-dek">{ post.description }</p>
			</header>
			<div class="article-body">{! string(post.html) }</div>
		</article>
	}
}
